            <div class="harmony-field harmony-field-button">
                <button class="harmony-btn harmony-btn-secondary" onclick="pesquisarFeriasHarmony()">Pesquisar</button>
            </div>
        </div>

        <div id="harmonyResultadoPesquisaFerias" class="harmony-search-results">
            Digite algo para pesquisar nos utilizadores pendentes.
        </div>
