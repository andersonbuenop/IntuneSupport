        <div class="harmony-form-grid">
            <div class="harmony-field">
                <label>Pesquisar utilizador</label>
                <input id="harmonyPesquisaFerias" class="form-control" placeholder="Exemplo: s800147, Maria Cristina, iPhone..." oninput="pesquisarFeriasHarmony()" />
                <small>Pesquisa em Email, Nome Entra/AD e nome do dispositivo.</small>
