    } else { "" }

    $managerText = if ($Row.ManagerEmail) {
        "Este aviso está a ser enviado ao utilizador e ao respetivo manager."
    } else {
        "Não foi identificado manager associado no Active Directory. O utilizador deverá contactar o seu manager para regularização."
    }

    return @"
