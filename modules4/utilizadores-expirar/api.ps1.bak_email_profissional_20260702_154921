            </p>

            <div style="background:#fafafa;border:1px solid #eeeeee;border-radius:12px;padding:16px;margin:18px 0;">
                <table style="width:100%;border-collapse:collapse;font-size:14px;">
                    <tr>
                        <td style="padding:8px 0;color:#666;width:190px;"><b>Utilizador</b></td>
                        <td style="padding:8px 0;">$($Row.SamAccountName)</td>
