                    </tr>
                    <tr>
                        <td style="padding:8px 0;color:#666;"><b>Email</b></td>
                        <td style="padding:8px 0;">$($Row.Email)</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0;color:#666;"><b>Manager</b></td>
