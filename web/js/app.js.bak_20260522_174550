let todosModulos = [];

async function carregarDashboard() {

    document.getElementById("pageTitle").innerText = "Dashboard";

    document.getElementById("pageSubtitle").innerText =
        "Sistema modular em homologação";

    document.getElementById("content").innerHTML = `
        <div class="card">
            <h2>Bem-vindo</h2>

            <p>
                Esta é a base V2 do Santander Support Web.
            </p>

            <p>
                Use o menu <strong>Ferramentas</strong>
                para abrir os módulos disponíveis.
            </p>
        </div>
    `;
}

async function carregarModulos() {

    const response = await fetch("/api/modules");

    const data = await response.json();

    console.log("MODULOS:", data);

    if (data.success) {
        todosModulos = data.modules;
    }
}

async function carregarFerramentas() {

    document.getElementById("pageTitle").innerText =
        "Ferramentas";

    document.getElementById("pageSubtitle").innerText =
        "Módulos disponíveis";

    await carregarModulos();

    let html = `
        <div class="card">

            <h2>Ferramentas</h2>

            <div class="module-grid">
    `;

    todosModulos.forEach(modulo => {

        html += `
            <div class="module-card"
                 onclick="abrirModulo(
                    '${modulo.name}',
                    '${modulo.title}',
                    '${modulo.description}'
                 )">

                <h3>${modulo.title}</h3>

                <p>${modulo.description}</p>

                <small>
                    Categoria: ${modulo.category}
                </small>

            </div>
        `;
    });

    html += `
            </div>

        </div>
    `;

    document.getElementById("content").innerHTML = html;
}

async function abrirModulo(moduleName, title, description) {

    document.getElementById("pageTitle").innerText = title;

    document.getElementById("pageSubtitle").innerText =
        description;

    const pageResponse =
        await fetch(`/module/${moduleName}/page`);

    const html = await pageResponse.text();

    document.getElementById("content").innerHTML = html;

    await carregarScriptModulo(moduleName);
}

async function carregarScriptModulo(moduleName) {

    const oldScript =
        document.getElementById("module-script");

    if (oldScript) {
        oldScript.remove();
    }

    const script = document.createElement("script");

    script.id = "module-script";

    script.src =
        `/module/${moduleName}/script?v=${Date.now()}`;

    document.body.appendChild(script);
}

async function abrirDebug() {

    document.getElementById("pageTitle").innerText =
        "Debug";

    document.getElementById("pageSubtitle").innerText =
        "Logs do servidor";

    const response = await fetch("/api/debug");

    const data = await response.json();

    document.getElementById("content").innerHTML = `
        <div class="card">

            <h2>Debug da aplicação</h2>

            <p>
                <strong>Ambiente:</strong>
                ${data.environment}
            </p>

            <p>
                <strong>UseMock:</strong>
                ${data.useMock}
            </p>

            <p>
                <strong>AppRoot:</strong>
                ${data.appRoot}
            </p>

        </div>

        <div class="card">

            <h3>Últimos logs</h3>

            <pre>${data.logs.join("\n")}</pre>

        </div>
    `;
}

function mostrarAmbiente() {

    document.getElementById("environmentBadge").innerHTML = `
        <span class="badge badge-homolog">
            HOMOLOG / MOCK
        </span>
    `;
}

mostrarAmbiente();

carregarDashboard();

carregarModulos();