async function conectarExchangeOnline() {
    const status = document.getElementById("exchangeStatus");

    if (status) {
        status.innerText = "A conectar ao Exchange Online...";
        status.style.color = "#111827";
    }

    try {
        const response = await fetch("/api/exchange/connect", {
            method: "POST"
        });

        const data = await response.json();

        if (data.success) {
            status.innerText = "Exchange Online conectado com sucesso";
            status.style.color = "green";
        } else {
            status.innerText = data.message || "Erro ao conectar Exchange Online";
            status.style.color = "red";
        }
    } catch (error) {
        status.innerText = "Erro ao chamar API /api/exchange/connect";
        status.style.color = "red";
    }
}




function copiarRespostaMudancaBalcao() {
    const campo = document.getElementById("respostaTicketMudancaBalcao");

    if (!campo) {
        alert("Campo de resposta não encontrado.");
        return;
    }

    const texto = campo.value || campo.innerText || campo.textContent || "";

    if (!texto.trim()) {
        alert("Não existe resposta para copiar.");
        return;
    }

    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(texto).then(function () {
            alert("Resposta copiada com sucesso.");
        }).catch(function () {
            copiarRespostaFallback(texto);
        });
    } else {
        copiarRespostaFallback(texto);
    }
}

function copiarRespostaFallback(texto) {
    const temp = document.createElement("textarea");
    temp.value = texto;
    temp.style.position = "fixed";
    temp.style.left = "-9999px";
    document.body.appendChild(temp);
    temp.focus();
    temp.select();

    try {
        document.execCommand("copy");
        alert("Resposta copiada com sucesso.");
    } catch (e) {
        alert("Não foi possível copiar automaticamente. Selecione o texto e copie manualmente.");
    }

    document.body.removeChild(temp);
}
