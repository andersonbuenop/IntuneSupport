function abrirModuloSeguro(el) {
    try {
        const raw = el.getAttribute("data-module-json");
        const modulo = JSON.parse(decodeURIComponent(escape(atob(raw))));

        const moduleKey = modulo.id || modulo.module || modulo.name;

        if (!moduleKey) {
            alert("Erro: módulo sem id/module/name.");
            console.error("Módulo inválido:", modulo);
            return;
        }

        abrirModulo(moduleKey, modulo.title || moduleKey, modulo.description || "");
    } catch (e) {
        alert("Erro ao abrir módulo: " + e.message);
        console.error(e);
    }
}

async function abrirModulo(moduleName, title, description) {
    if (window.vuCleanupOperationPanel) {
        try { window.vuCleanupOperationPanel(); } catch(e) {}
    }
    const oldVuPanel = document.getElementById("vuOperationPanel");
    if (oldVuPanel) oldVuPanel.remove();
    if (!moduleName || moduleName === "undefined" || moduleName === "null") {
        console.error("abrirModulo recebeu moduleName vazio:", moduleName, title, description);
        document.getElementById("content").innerHTML = `<pre>Erro: moduleName vazio ao abrir módulo.\nTítulo: ${title || ""}</pre>`;
        return;
    }
    document.getElementById("pageTitle").innerText = title;
    document.getElementById("pageSubtitle").innerText = description;

    const pageResponse = await fetch(`/module/${moduleName}/page`);
    const html = await pageResponse.text();

    document.getElementById("content").innerHTML = html;

    await carregarScriptModulo(moduleName);
}

async function carregarScriptModulo(moduleName) {
    const oldScript = document.getElementById("module-script");

    if (oldScript) {
        oldScript.remove();
    }

    const script = document.createElement("script");
    script.id = "module-script";
    script.src = `/module/${moduleName}/script?v=${Date.now()}`;

    document.body.appendChild(script);
}

