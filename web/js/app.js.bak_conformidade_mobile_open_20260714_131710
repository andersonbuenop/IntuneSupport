/* SANTANDER_CONFORMIDADE_MOBILE_CARD_V30 */
(function () {
  "use strict";

  var MODULE_ID = "intune-conformidade-mobile";
  var MODULE_TITLE = "Conformidade Mobile";
  var MODULE_DESCRIPTION =
    "Diagnóstico de equipamentos móveis em carência ou não conformes, com análise Harmony.";

  function textOf(element) {
    return String((element && (element.innerText || element.textContent)) || "")
      .replace(/\s+/g, " ")
      .trim();
  }

  function alreadyExists() {
    return !!document.querySelector(
      '[data-module-id="' + MODULE_ID + '"], ' +
      '[data-module="' + MODULE_ID + '"], ' +
      '#card-' + MODULE_ID
    );
  }

  function findExistingCardByTitle(title) {
    var all = Array.prototype.slice.call(
      document.querySelectorAll("article, a, section, div, li")
    );

    var titleLower = title.toLowerCase();
    var matches = all.filter(function (element) {
      var text = textOf(element).toLowerCase();
      if (text.indexOf(titleLower) < 0) return false;
      if (text.length > 700) return false;

      var rect = element.getBoundingClientRect();
      return rect.width >= 150 && rect.height >= 80;
    });

    matches.sort(function (a, b) {
      var areaA = a.getBoundingClientRect().width * a.getBoundingClientRect().height;
      var areaB = b.getBoundingClientRect().width * b.getBoundingClientRect().height;
      return areaA - areaB;
    });

    return matches[0] || null;
  }

  function openConformidadeMobile(event) {
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }

    var functions = [
      window.abrirModuloSeguro,
      window.abrirModulo,
      window.openModule,
      window.loadModule,
      window.navigateToModule
    ];

    for (var i = 0; i < functions.length; i++) {
      if (typeof functions[i] !== "function") continue;
      try {
        functions[i](MODULE_ID);
        return false;
      } catch (error) {
        console.warn("[Conformidade Mobile] Tentativa de abertura falhou:", error);
      }
    }

    window.location.href = "/module/" + MODULE_ID;
    return false;
  }

  function replaceTextNodes(root) {
    var walker = document.createTreeWalker(
      root,
      NodeFilter.SHOW_TEXT,
      null,
      false
    );

    var nodes = [];
    var node;

    while ((node = walker.nextNode())) {
      nodes.push(node);
    }

    nodes.forEach(function (textNode) {
      var value = textNode.nodeValue || "";
      value = value.replace(/Controle Harmony/gi, MODULE_TITLE);
      value = value.replace(
        /Relatório de dispositivos Harmony com status diferente de Active através de ficheiro CSV\.?/gi,
        MODULE_DESCRIPTION
      );
      textNode.nodeValue = value;
    });
  }

  function configureCard(card) {
    card.id = "card-" + MODULE_ID;
    card.setAttribute("data-module-id", MODULE_ID);
    card.setAttribute("data-module", MODULE_ID);
    card.setAttribute("data-id", MODULE_ID);

    replaceTextNodes(card);

    var headings = card.querySelectorAll("h1,h2,h3,h4,h5,h6,strong");
    if (headings.length) {
      headings[0].textContent = MODULE_TITLE;
    }

    var paragraphs = card.querySelectorAll("p");
    if (paragraphs.length) {
      paragraphs[0].textContent = MODULE_DESCRIPTION;
    }

    var links = card.querySelectorAll("a");
    Array.prototype.forEach.call(links, function (link) {
      link.removeAttribute("onclick");
      link.href = "/module/" + MODULE_ID;
      link.addEventListener("click", openConformidadeMobile);
    });

    var buttons = card.querySelectorAll("button");
    Array.prototype.forEach.call(buttons, function (button) {
      button.removeAttribute("onclick");
      button.addEventListener("click", openConformidadeMobile);
    });

    card.addEventListener("click", function (event) {
      if (event.target.closest("a,button")) return;
      openConformidadeMobile(event);
    });

    card.style.display = "";
    card.removeAttribute("hidden");
    card.classList.remove("hidden");
  }

  function publishCard() {
    if (!document.body || alreadyExists()) return true;

    var sourceCard =
      findExistingCardByTitle("Controle Harmony") ||
      findExistingCardByTitle("Devices Intune") ||
      findExistingCardByTitle("Instalação Intune");

    if (!sourceCard || !sourceCard.parentElement) {
      return false;
    }

    var card = sourceCard.cloneNode(true);
    configureCard(card);

    var resetCard = findExistingCardByTitle("Reset MFA");
    if (resetCard && resetCard.parentElement === sourceCard.parentElement) {
      resetCard.insertAdjacentElement("afterend", card);
    } else {
      sourceCard.parentElement.appendChild(card);
    }

    console.info("[Conformidade Mobile] Cartão publicado com sucesso.");
    return true;
  }

  function startPublication() {
    if (publishCard()) return;

    var attempts = 0;
    var timer = window.setInterval(function () {
      attempts++;
      if (publishCard() || attempts >= 60) {
        window.clearInterval(timer);
      }
    }, 500);

    var observer = new MutationObserver(function () {
      if (publishCard()) {
        observer.disconnect();
        window.clearInterval(timer);
      }
    });

    observer.observe(document.documentElement, {
      childList: true,
      subtree: true
    });

    window.setTimeout(function () {
      observer.disconnect();
      window.clearInterval(timer);
    }, 30000);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startPublication, { once: true });
  } else {
    startPublication();
  }
})();
