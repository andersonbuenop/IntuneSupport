/* ============================================================
   PROGRESS GLOBAL - SantanderSupportWebV2
   Uso:
   criarProgressGlobal("idDoContainer");
   atualizarProgressGlobal("idDoContainer", 50, "Texto...");
   finalizarProgressGlobal("idDoContainer", true, "Concluído");
   resetarProgressGlobal("idDoContainer");
   ============================================================ */

function criarProgressGlobal(containerId) {

    const container = document.getElementById(containerId);

    if (!container) {
        console.warn("Progress container não encontrado:", containerId);
        return;
    }

    if (container.dataset.progressReady === "true") {
        return;
    }

    container.className = "global-progress-container";
    container.innerHTML = `
        <div class="global-progress-wrapper">
            <div class="global-progress-bar" id="${containerId}_bar">0%</div>
        </div>
        <div class="global-progress-text" id="${containerId}_text">Aguardando...</div>
    `;

    container.dataset.progressReady = "true";
}

function atualizarProgressGlobal(containerId, percentagem, texto) {

    criarProgressGlobal(containerId);

    const container = document.getElementById(containerId);
    const barra = document.getElementById(containerId + "_bar");
    const status = document.getElementById(containerId + "_text");

    if (!container || !barra || !status) {
        return;
    }

    let valor = parseInt(percentagem);

    if (isNaN(valor)) {
        valor = 0;
    }

    if (valor < 0) valor = 0;
    if (valor > 100) valor = 100;

    container.style.display = "block";
    container.classList.remove(
        "global-progress-success",
        "global-progress-error",
        "global-progress-warning"
    );

    barra.style.width = valor + "%";
    barra.innerHTML = valor + "%";
    status.innerHTML = texto || "A processar...";
}

function finalizarProgressGlobal(containerId, sucesso, texto) {

    atualizarProgressGlobal(containerId, 100, texto);

    const container = document.getElementById(containerId);

    if (!container) {
        return;
    }

    container.classList.remove(
        "global-progress-success",
        "global-progress-error",
        "global-progress-warning"
    );

    if (sucesso === true) {
        container.classList.add("global-progress-success");
    }
    else {
        container.classList.add("global-progress-error");
    }
}

function resetarProgressGlobal(containerId) {

    criarProgressGlobal(containerId);

    const container = document.getElementById(containerId);
    const barra = document.getElementById(containerId + "_bar");
    const status = document.getElementById(containerId + "_text");

    if (!container || !barra || !status) {
        return;
    }

    container.style.display = "none";
    container.classList.remove(
        "global-progress-success",
        "global-progress-error",
        "global-progress-warning"
    );

    barra.style.width = "0%";
    barra.innerHTML = "0%";
    status.innerHTML = "Aguardando...";
}


